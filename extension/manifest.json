{
  "manifest_version": 3,
  "name": "Music Player Widget Bridge",
  "description": "Lets the music-player-widget desktop widget read and control YouTube Music's shuffle, repeat and track time.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{
    "matches": ["https://music.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
